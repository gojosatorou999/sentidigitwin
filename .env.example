# Sentinel AI environment. Copy to `.env` and fill in what you need.
# `.env` is gitignored -- never commit real keys.

SECRET_KEY=change-me
# DATABASE_URL=postgresql://user:pass@host/dbname   # omit for sqlite:///site.db

# --- Twilio (WhatsApp + SMS alerts) ---
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_NUMBER=
TWILIO_PHONE_NUMBER=

# --- Firebase push ---
FIREBASE_SERVER_KEY=


# ===========================================================================
# Urban Digital Twin (twin/)
#
# The twin's core loop needs NONE of these. Every variable below is either a
# tuning knob with a sane default or an optional Tier-2 enhancement: without
# any of them the twin still scores both cities, still renders, and still
# shows street-level imagery (via keyless KartaView).
# ===========================================================================

TWIN_ENABLED=1
TWIN_H3_RESOLUTION=8
TWIN_SCHEDULER_ENABLED=1
TWIN_COMPUTE_INTERVAL_MIN=5
TWIN_WEATHER_INTERVAL_MIN=15
TWIN_CACHE_DIR=data/twin/cache
TWIN_HTTP_TIMEOUT_S=8

# Metres searched around a cell centroid for street-level imagery. The
# adapter automatically retries once at ~900 m for cells this finds nothing in.
TWIN_STREETVIEW_RADIUS_M=350

# --- Optional keyed sources ---

# TomTom Traffic Flow -- adds the congestion tile overlay to the layer panel.
# Free tier at https://developer.tomtom.com
TOMTOM_API_KEY=

# Mapillary -- denser and more recent street-level imagery than KartaView in
# many Indian wards, so it is preferred when present. Free: create an app at
# https://www.mapillary.com/dashboard/developers and copy its client token
# (starts with "MLY|").
MAPILLARY_TOKEN=

# Windy Webcams -- adds genuinely *live* nearby cameras alongside the archived
# street-level photos. Free tier at https://api.windy.com/webcams
WINDY_WEBCAMS_KEY=

# Tomorrow.io -- higher-resolution nowcast, alternative to Open-Meteo.
TOMORROW_API_KEY=

# data.gov.in -- live CPCB air-quality stations, plus census/ward population.
#
# STRONGLY RECOMMENDED. Without it the adapter falls back to the sample key
# data.gov.in publishes in its own documentation, which is shared by everyone
# who has ever read those docs: it is capped at 10 rows and rate-limited to
# the point of being unusable in practice (429s and timeouts). A free key at
# https://data.gov.in/user/register takes a minute and removes both limits.
DATA_GOV_IN_KEY=


# ===========================================================================
# Live data sources (Phase 1-2)
#
# Still all optional. Each absent key hides one layer; none of them stops the
# twin from booting, scoring or rendering.
# ===========================================================================

# NDMA SACHET official CAP alerts -- KEYLESS and already working. These are
# the feeds the alert layer and the agent's highest-weight signal come from.
TWIN_ALERTS_ENABLED=1
TWIN_ALERT_POLL_MIN=5
TWIN_SACHET_STATES=telangana,karnataka

# OpenAQ v3 -- extra pollution sensors. Free key: https://explore.openaq.org/register
OPENAQ_API_KEY=

# AQICN / WAQI -- dense station coverage. Free token: https://aqicn.org/data-platform/token/
# Note: AQICN reports the US EPA index; the twin converts to the CPCB scale.
AQICN_TOKEN=

# IUDX (India Urban Data Exchange) -- municipal sensor feeds where a city
# publishes them. The catalogue is public and needs nothing; reading actual
# resources needs an account at https://iudx.org.in
IUDX_TOKEN=

# Live transit. No Indian operator publishes a stable public GTFS-RT endpoint,
# so these are per-deployment configuration rather than defaults. JSON maps of
# city slug -> URL. With none set, the transit layer simply does not appear.
#   TWIN_GTFS_RT_URLS={"bengaluru": "https://example/vehiclepositions.pb"}
#   TWIN_GTFS_STATIC_URLS={"bengaluru": "https://example/gtfs.zip"}
#   TWIN_GTFS_RT_HEADERS={"bengaluru": {"Authorization": "Bearer ..."}}
TWIN_GTFS_RT_URLS=
TWIN_GTFS_STATIC_URLS=
TWIN_GTFS_RT_HEADERS=

# Operator-supplied live CCTV. No public live camera stream exists for either
# modelled city, so this file is empty by default. Point it at a JSON list when
# you have real feed access (ICCC, police, campus). The server never proxies or
# stores these streams -- the browser plays them directly.
TWIN_CCTV_STREAMS_FILE=data/twin/cctv_streams.json

# Public road-authority camera catalogs (twin/ingest/cctv_live.py). Keyless.
# Ten authorities are registered -- Austin, Caltrans, TfL, Ontario 511,
# Fintraffic, DriveBC, Transport for NSW, Calgary, Hong Kong's Transport
# Department and Singapore's LTA. Each declares the ground it serves and is
# fetched ONLY when that ground meets the bbox being asked about, so a foreign
# city's cameras can never stand in for a local one. No registered authority
# covers Hyderabad or Bengaluru -- none exists to register; see
# SYSTEMS.md section 3.
TWIN_CCTV_LIVE_ENABLED=1
# Comma-separated provider keys to allow; empty means every registered one.
TWIN_CCTV_LIVE_PROVIDERS=
TWIN_CCTV_LIVE_CACHE_TTL_S=900
TWIN_CCTV_LIVE_MAX_CAMERAS=1200
TWIN_CCTV_LIVE_TIMEOUT_S=15

# Reference feed. The coverage gate above is right, but its consequence here
# is a panel that is empty in BOTH modelled cities and so can never be seen
# working -- a real layer that looks broken. When no authority covers the
# city, and only then, the panel shows a small live sample from another
# authority under a "not local" banner. Those streams are flagged, carry no
# coordinates, stay off the map, and are never read by scoring, flags or
# briefs. An operator feed in cctv_streams.json suppresses them entirely.
# Set to 0 for the strictly-empty panel.
TWIN_CCTV_REFERENCE_ENABLED=1
# Which registered provider stands in. Hong Kong by default: the densest
# keyless catalog in the registry (1,013 cameras), plain JPEG stills the
# existing image player refreshes without a video stack, and the nearest
# such authority to the modelled cities.
TWIN_CCTV_REFERENCE_PROVIDER=hongkong
# How many to show. Small on purpose: a demonstration, not a second city.
TWIN_CCTV_REFERENCE_MAX=24


# ===========================================================================
# Forecast agent (twin/forecast.py, twin/agent/forecast_graph.py)
# ===========================================================================
# The triage agent reads what is already true. This one projects a rain field
# along the wind vector to say where it will land and in how long, and reads
# apparent-temperature crossings to say when heat will bite -- so an analyst
# can warn people before it arrives rather than after.
#
# It writes to the same twin_flag table behind the same pending gate, so it
# appears in the same console queue with the same dispatch buttons, and
# nothing it produces reaches the public without a human click. Every number
# comes from arithmetic on Open-Meteo's hourly series; the LLM only writes
# the brief. Keyless. Runs inside the existing agent job.
TWIN_FORECAST_ENABLED=1


# ===========================================================================
# Anomaly baselines (Phase 3)
#
# Fill twin_baseline once with:  python scripts/backfill_baselines.py
# Until then the twin scores normally but cannot call anything "unusual".
# ===========================================================================

TWIN_BASELINE_YEARS=5
TWIN_ANOMALY_SIGMA_WATCH=1.5
TWIN_ANOMALY_SIGMA_ALERT=2.5


# ===========================================================================
# Triage agent (Phase 4)
#
# The agent runs WITHOUT any of this: it reads alerts from their structured
# CAP fields, groups events spatially and writes briefs from templates. A key
# adds language understanding to those three jobs and nothing else -- risk
# scores are always computed by twin/scoring.py, never by a model.
#
# OpenAI only. gpt-5-nano is OpenAI's cheapest text model ($0.05 in /
# $0.40 out per 1M tokens). Keep reasoning effort at "minimal": gpt-5-nano
# bills its hidden reasoning as output tokens.
# ===========================================================================

TWIN_AGENT_ENABLED=1
TWIN_AGENT_INTERVAL_MIN=10
TWIN_FLAG_THRESHOLD=55
TWIN_FLAG_TTL_HOURS=12

OPENAI_API_KEY=
TWIN_LLM_MODEL=gpt-5-nano
TWIN_LLM_REASONING_EFFORT=minimal

# Document retrieval for the briefs. Local, keyless and free; drop SOPs and
# past situation reports (.md/.txt/.json) into the corpus directory.
TWIN_RAG_CORPUS_DIR=data/twin/corpus
TWIN_RAG_EMBEDDING_MODEL=all-MiniLM-L6-v2


# ===========================================================================
# Public dispatch (Phase 5) -- the only path that reaches real people
#
# Requires an analyst's click in every case. These are the guard rails around
# that click, not a way to automate it.
# ===========================================================================

# Minutes before the same flag can be re-alerted without an explicit override.
TWIN_DISPATCH_COOLDOWN_MIN=30
# Hard ceiling an analyst cannot exceed from the console.
TWIN_DISPATCH_MAX_RADIUS_KM=25
# Extra margin around a flagged area, so someone just outside it is still told.
TWIN_DISPATCH_BUFFER_KM=1.5
