# Sentinel AI environment. Copy to `.env` and fill in what you need.
# `.env` is gitignored -- never commit real keys.

SECRET_KEY=change-me
# DATABASE_URL=postgresql://user:pass@host/dbname   # omit for sqlite:///site.db

# --- Twilio (WhatsApp + SMS alerts) ---
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_NUMBER=
TWILIO_PHONE_NUMBER=

# --- Firebase push ---
FIREBASE_SERVER_KEY=


# ===========================================================================
# Urban Digital Twin (twin/)
#
# The twin's core loop needs NONE of these. Every variable below is either a
# tuning knob with a sane default or an optional Tier-2 enhancement: without
# any of them the twin still scores both cities, still renders, and still
# shows street-level imagery (via keyless KartaView).
# ===========================================================================

TWIN_ENABLED=1
TWIN_H3_RESOLUTION=8
TWIN_SCHEDULER_ENABLED=1
TWIN_COMPUTE_INTERVAL_MIN=5
TWIN_WEATHER_INTERVAL_MIN=15
TWIN_CACHE_DIR=data/twin/cache
TWIN_HTTP_TIMEOUT_S=8

# Metres searched around a cell centroid for street-level imagery. The
# adapter automatically retries once at ~900 m for cells this finds nothing in.
TWIN_STREETVIEW_RADIUS_M=350

# --- Optional keyed sources ---

# TomTom Traffic Flow -- adds the congestion tile overlay to the layer panel.
# Free tier at https://developer.tomtom.com
TOMTOM_API_KEY=

# Mapillary -- denser and more recent street-level imagery than KartaView in
# many Indian wards, so it is preferred when present. Free: create an app at
# https://www.mapillary.com/dashboard/developers and copy its client token
# (starts with "MLY|").
MAPILLARY_TOKEN=

# Windy Webcams -- adds genuinely *live* nearby cameras alongside the archived
# street-level photos. Free tier at https://api.windy.com/webcams
WINDY_WEBCAMS_KEY=

# Tomorrow.io -- higher-resolution nowcast, alternative to Open-Meteo.
TOMORROW_API_KEY=

# data.gov.in -- real census/ward population instead of an OSM-density estimate.
DATA_GOV_IN_KEY=
