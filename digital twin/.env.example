# Digital twin environment variables (DIGITAL_TWIN_README.md section 11).
# Copy this file to `.env` and fill in values. `.env` itself is gitignored --
# never commit real keys. The core loop needs NONE of these (C5): every
# variable below is a Tier-2 enhancement or a tuning knob with a sane default.

# --- Twin core (all optional; defaults live in twin/config.py) ---
TWIN_ENABLED=1
TWIN_H3_RESOLUTION=8
TWIN_SCHEDULER_ENABLED=1
TWIN_COMPUTE_INTERVAL_MIN=5
TWIN_WEATHER_INTERVAL_MIN=15
TWIN_CACHE_DIR=data/twin/cache
TWIN_HTTP_TIMEOUT_S=8

# --- Optional keyed sources (section 4.2) ---
# TomTom Traffic Flow: adds a congestion overlay + traffic_index sub-signal.
# Get one free at https://developer.tomtom.com (Orbis / Maps APIs, free tier).
TOMTOM_API_KEY=

# Tomorrow.io: higher-res nowcast, alternative to Open-Meteo.
TOMORROW_API_KEY=

# data.gov.in: real census/ward population data instead of an OSM-density
# estimate. Get a free key at https://data.gov.in -- see the instructions
# below (register, verify email, copy the API key from your profile).
DATA_GOV_IN_KEY=
